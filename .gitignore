# ==============================================================================
# Python Cache and Bytecode
# ==============================================================================
# Directory patterns below are anchored with a leading "/" so they only match at
# the repository root. An unanchored "lib/" or "build/" would also match
# "src/.../lib/", which is how a source directory ends up silently untracked.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# System Files (macOS / Windows / Linux)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo

# ==============================================================================
# Virtual Environments & Packages
# ==============================================================================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
ai_env/
conda-env/

# ==============================================================================
# IDEs / Editors
# ==============================================================================
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.ipynb_checkpoints/
.jupyter/
.cursorrules

# ==============================================================================
# Deep Learning / Model Checkpoints / Weights
# ==============================================================================
# Ignore all raw model files, checkpoints, and serialized architectures
*.pt
*.pth
*.ckpt
*.onnx
*.pb
*.tflite
*.weights
*.h5
*.joblib
*.pkl
*.pickle

# ==============================================================================
# Experiment Tracking & Logs (Hydra, Tensorboard, WandB)
# ==============================================================================
# Hydra output folders for local run logs and snapshots
/outputs/
/multirun/

# Tensorboard logs
/runs/
.tensorboard/

# Weights & Biases logs (written into each Hydra run directory)
wandb/

# MLflow tracking
/mlruns/

# General log files
*.log
*.log.jsonl
events.out.tfevents.*

# ==============================================================================
# Dataset / Data / Dataframes
# ==============================================================================
# Datasets dropped into the repository root. These MUST stay anchored: an
# unanchored "datasets/" also matches the source package "src/datasets/", which
# would silently untrack every new module added there.
/data/
/data_inputs/
/datasets/
/raw_data/
*.xlsx
*.parquet

# Generated metadata manifests (see data.save_csv_path), not source data.
*.csv
